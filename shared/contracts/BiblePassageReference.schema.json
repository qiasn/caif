{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qiassoc.org/caif/contracts/BiblePassageReference.schema.json",
  "title": "BiblePassageReference",
  "description": "Canonical CAIF representation of a reference to a Biblical passage.",
  "type": "object",
  "additionalProperties": false,

  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },

    "book": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical book name."
    },

    "chapter": {
      "type": "integer",
      "minimum": 1
    },

    "verse_start": {
      "type": ["integer", "null"],
      "minimum": 1
    },

    "verse_end": {
      "type": ["integer", "null"],
      "minimum": 1
    },

    "chapter_start": {
      "type": ["integer", "null"],
      "minimum": 1
    },

    "chapter_end": {
      "type": ["integer", "null"],
      "minimum": 1
    },

    "original_text": {
      "type": ["string", "null"],
      "description": "Original textual form before normalization."
    },

    "language": {
      "type": ["string", "null"],
      "description": "Language of the original reference when known."
    },

    "canon_profile": {
      "type": ["string", "null"],
      "description": "Canon profile when relevant to book identity or numbering."
    },

    "confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },

    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },

  "required": [
    "schema_version",
    "book",
    "chapter"
  ]
}