{
  "schema_version": "1.0",
  "data_version": "0.1.0",
  "matching_normalization": {
    "steps": [
      "Apply Unicode NFC to the book token only.",
      "Collapse runs of ASCII whitespace (U+0009 through U+000D and U+0020) to one U+0020, then trim leading/trailing U+0020.",
      "For en only, fold ASCII A-Z to a-z."
    ],
    "unicode_normalization_version": "15.0.0",
    "preserve": "Do not remove punctuation, collapse internal spaces to nothing, convert scripts, interpret Roman numerals, or change original_text. Such parser behaviors need separate specification.",
    "language_selection": "A supplied en, zh-Hant, or zh-Hans selects that tag. A broad zh hint searches both Chinese tags. Unknown language searches all three and unions candidates; identical spellings cannot establish script.",
    "collision_policy": "Union candidate book_ids for every matching normalized token in eligible languages; deduplicate identical IDs. Candidate order never resolves ambiguity. Multiple candidates require clarification.",
    "tokenization_boundary": "This table maps complete book tokens only. A parser must use reference grammar and the specification; prefix or longest-string matching alone is not sufficient. Required 約三16 means John 3:16."
  },
  "provenance": {
    "curation": "Conservative CAIF P0 selection of ordinary Protestant full names and abbreviations, checked against pinned OpenBible sources. The broad upstream recognition repertoire, misspellings, and other traditions are not imported wholesale.",
